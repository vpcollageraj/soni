# SONIVOLT store — environment variables
# Copy this file to .env.local and fill in values as they become available.
# Every value below is OPTIONAL. Anything not configured stays disabled and
# the related feature falls back to a working manual alternative.

# Base URL used in links (order confirmations, sitemap). Defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- NOT CONFIGURED YET (documented for the future) -------------------------
# Online payments (e.g. Razorpay) are intentionally NOT wired in this build.
# When a gateway account is added, its keys belong here as SERVER-SIDE env vars
# only — never NEXT_PUBLIC_ and never in frontend code.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Email delivery (order confirmation e-mails) is not configured yet.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
